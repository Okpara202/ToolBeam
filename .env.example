# ---------------------------------------------------------------------------
# Toolbeam API — environment
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers. Remember to append the db name.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/toolbeam?retryWrites=true&w=majority

# Where `npm test` runs. A scratch database on the same cluster is ideal — the
# suite wipes every collection between tests, so never point this at the one
# above. Leave it unset to use an ephemeral in-memory MongoDB instead, which
# needs no cluster but downloads a ~600MB binary on first run
# (`npm run test:warm` gets that over with up front).
TEST_DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/toolbeam_test?retryWrites=true&w=majority

# Secret used to sign JWT access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=7d

# Public base URL the Swagger "Try it out" button should call.
API_BASE_URL=http://localhost:8000

# Comma-separated CORS allowlist. Leave blank to allow any origin (dev only).
ALLOWED_ORIGIN=

# Serve Swagger UI at /docs. Kept separate from NODE_ENV on purpose so the
# deployed instance can expose its docs publicly.
ENABLE_DOCS=true

# ---------------------------------------------------------------------------
# Seed script — the demo account created by `npm run seed`
# ---------------------------------------------------------------------------
SEED_USER_EMAIL=demo@toolbeam.dev
SEED_USER_PASSWORD=Toolbeam123!
