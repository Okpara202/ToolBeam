{
  "name": "toolbeam-api",
  "version": "1.0.0",
  "description": "Toolbeam — the backend API powering an AI tools directory: submit, upvote, and discover AI tools by recency, popularity, and relation.",
  "main": "dist/server.mjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "seed": "tsx scripts/seed.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:warm": "node scripts/warm-test-db.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "lint:fix": "eslint src scripts tests --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "ai-tools",
    "directory",
    "express",
    "typescript",
    "mongodb",
    "ranking"
  ],
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^10.2.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  }
}
